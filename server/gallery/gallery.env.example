# Load these values into the gallery service environment on 10.1.1.23.
# install.sh preserves saved settings; --port and --max-upload-mb explicitly change their respective settings.
# The installer checks this fixed backend address and detects its LAN firewall zone.
HOST=10.1.1.23
PORT=8787
# Use install.sh --port 8788 if 8787 belongs to another app; copy the generated nginx snippet to the proxy.
GALLERY_ORIGIN=https://lidoll.dev
GALLERY_DATA_DIR=/var/lib/lidoll-gallery
GALLERY_MAX_UPLOAD_MB=1024
# Values are MiB (1024 = 1 GiB per file); nginx's client_max_body_size must match.

# Register this PKCE public client with the exact /gallery/auth/callback URI.
GALLERY_OIDC_ISSUER=https://auth.sadgirlsclub.wtf
GALLERY_OIDC_CLIENT_ID=lidoll-gallery
# ffmpeg must support the codecs used by uploaded videos; failed previews never expose originals.
GALLERY_FFMPEG=/usr/bin/ffmpeg
