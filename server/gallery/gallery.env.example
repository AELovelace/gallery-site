# Load these values into the gallery service environment on 10.1.1.23.
# install.sh creates /etc/lidoll-gallery.env on first use; --port changes only PORT on updates.
# The installer checks this fixed backend address and detects its LAN firewall zone.
HOST=10.1.1.23
PORT=8787
# Use install.sh --port 8788 if 8787 belongs to another app; copy the generated nginx snippet to the proxy.
GALLERY_ORIGIN=https://lidoll.dev
GALLERY_DATA_DIR=/var/lib/lidoll-gallery
GALLERY_MAX_UPLOAD_MB=250
