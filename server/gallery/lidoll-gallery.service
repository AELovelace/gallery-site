[Unit]
Description=LiDOLL photo and video gallery
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=lidoll-gallery
Group=lidoll-gallery
# Match the installer's test/setup working directory so the service never needs access to the source checkout's parent directories.
# update.sh swaps only this application directory; it preserves the installed unit, environment, and StateDirectory.
WorkingDirectory=/opt/lidoll-gallery
EnvironmentFile=/etc/lidoll-gallery.env
# The installer accepts this existing runtime at 24.9+; changing the default node command has no effect here.
ExecStart=/usr/bin/node-24 /opt/lidoll-gallery/server/gallery/server.mjs
Restart=on-failure
RestartSec=5
StateDirectory=lidoll-gallery
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/lidoll-gallery

[Install]
WantedBy=multi-user.target
